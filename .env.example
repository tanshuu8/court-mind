# ==============================================================================
# CourtMind Environment Configuration
# Copy this file to .env and configure the actual values locally.
# NEVER commit .env to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_SECRET_KEY=change_this_to_a_secure_random_secret_in_production
API_V1_STR=/api

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER=courtmind_user
POSTGRES_PASSWORD=courtmind_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=courtmind_db
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
VECTOR_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# LLM Generation Service (Groq Primary, Google Gemini Secondary)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=qwen/qwen3.8-27b
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-3.5-flash
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=2048
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Optional External Legal Search Provider (Mode B Live Web Verification)
# Options: 'none' (default, uses structured model knowledge), 'tavily', 'serp'
EXTERNAL_SEARCH_PROVIDER=none
EXTERNAL_SEARCH_API_KEY=

# Persistent PDF Storage & Upload Limits
PDF_STORAGE_DIR=./data/stored_documents
MAX_UPLOAD_SIZE_MB=50

# ML Pipeline Paths
ML_MODEL_REGISTRY_PATH=./ml/models/saved_models
ML_DATA_DIR=./ml/data

# Frontend URLs (for CORS configuration)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
